{
  "name": "lorescape",
  "version": "1.0.0",
  "description": "LoreScape browser client and cache tools, based on the 2004Scape TypeScript client.",
  "dependencies": {
    "foundation-sites": "^6.8.1",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@types/foundation-sites": "^6.4.3",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^3.5.29",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "assemblyscript": "^0.27.27",
    "autoprefixer": "^10.4.19",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.0.11",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.2.5",
    "sass": "^1.105.2",
    "sass-loader": "^14.2.1",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "build": "npm run asc && webpack --mode=production --node-env=production",
    "build:dev": "npm run asc && webpack --mode=development",
    "build:prod": "npm run asc && webpack --mode=production --node-env=production",
    "dev": "npm run asc && webpack-dev-server --hot",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier src/**/*.{js,ts} --write",
    "prepare": "husky",
    "test": "npm run asc && jest",
    "asc": "asc --target release --optimizeLevel 3 --converge",
    "local": "npm run build:dev && npm run preview",
    "prod": "npm run build && npm run preview",
    "typecheck": "npm run asc && tsc --noEmit",
    "preview": "node scripts/preview.cjs",
    "check:pages": "node scripts/check-pages.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awest813/LoreScape.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/awest813/LoreScape/issues"
  },
  "homepage": "https://awest813.github.io/LoreScape/",
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.js": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
